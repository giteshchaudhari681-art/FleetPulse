# Application
NODE_ENV=development
API_PORT=3000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Authentication
JWT_SECRET=placeholder_secret_replace_in_production

# PostgreSQL
DATABASE_URL=postgres://user:password@localhost:5432/fleetpulse

# TimescaleDB (Telemetry)
TIMESCALEDB_URL=postgres://user:password@localhost:5433/telemetry

# Redis
REDIS_URL=redis://localhost:6379

# MQTT (Mosquitto)
MQTT_BROKER_URL=mqtt://localhost:1883
MQTT_USERNAME=admin
MQTT_PASSWORD=placeholder_password

# Observability
LOG_LEVEL=info
# OPENTELEMETRY_ENDPOINT=http://localhost:4318
